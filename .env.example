# Modelo de configuração da IA do Athenix (Azure OpenAI / Microsoft Foundry).
# Copie para .env (o .env fica fora do git) ou rode: python scripts/configurar_ia.py
# Todos os valores abaixo são FICTÍCIOS. Nunca coloque uma chave real neste arquivo.
# Variáveis já definidas no ambiente prevalecem sobre o .env.

# Modo da IA: off (padrão, nenhuma chamada), cached (só respostas gravadas) ou live (chamada paga).
# Deixe off; o live é ligado só na hora de uma execução confirmada.
ATHENIX_AI_MODE=off

# Endpoint do recurso, só a base, sem /openai/... no fim.
# Onde achar: no Foundry (ai.azure.com), no deployment do modelo, em "Target URI". Use só a parte
# até ".com". No portal do Azure: recurso → Resource Management → Keys and Endpoint → Endpoint.
# Formato: https://<nome-do-recurso>.openai.azure.com  (ou .cognitiveservices.azure.com)
ATHENIX_AZURE_ENDPOINT=https://exemplo-recurso.openai.azure.com

# Chave do recurso (KEY 1 ou KEY 2). Mesmo lugar do endpoint. Segredo: só no .env.
ATHENIX_API_KEY=

# Nome do DEPLOYMENT (o nome que você deu ao implantar o modelo, não o nome do modelo).
# Onde achar: Foundry → Models + endpoints (ou Deployments) → coluna "Name".
ATHENIX_MODEL=exemplo-deployment

# Versão da API. Aparece no fim do "Target URI" (?api-version=...). Padrão do Athenix:
ATHENIX_AZURE_API_VERSION=2025-04-01-preview

# Modelo de raciocínio (o-series, gpt-5 e similares): low, medium ou high.
# Modelo sem raciocínio (gpt-4.1, gpt-4o...): deixe VAZIO, senão o Azure recusa o pedido.
ATHENIX_REASONING_EFFORT=low

# Preço em US$ por 1 milhão de tokens, do modelo e do tipo de deployment (Global, Data Zone ou
# Regional) que você usa. Ponto como separador decimal.
# Onde achar: https://azure.microsoft.com/pricing/details/cognitive-services/openai-service/
ATHENIX_INPUT_USD_M=0.00
ATHENIX_OUTPUT_USD_M=0.00
# Página de onde o preço foi tirado (tem de começar com https://) e a data da consulta (AAAA-MM-DD,
# não futura).
ATHENIX_PRICE_SOURCE=https://azure.microsoft.com/pricing/details/cognitive-services/openai-service/
ATHENIX_PRICE_DATE=2026-01-01

# Teto de custo por execução, em US$. Execução que passaria do teto não roda.
ATHENIX_RUN_BUDGET_USD=0.50
