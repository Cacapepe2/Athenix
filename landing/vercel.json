{
  "headers": [
    {
      "source": "/fontes/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'none'; connect-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
